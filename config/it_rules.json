{
  "allowed_host": "api.vultrinference.com",
  "allowed_port": 443,
  "wall_check": {
    "timeout_s": 5,
    "expect_blocked": ["pypi.org", "github.com"],
    "expect_allowed": ["api.vultrinference.com"]
  },
  "room": {
    "image": "python:3.12",
    "cpus": 2,
    "memory_mb": 2048
  },
  "caps": {
    "tool_run_s": 300,
    "whole_run_s": 360,
    "max_agent_steps": 25,
    "gate_wait_s": 120,
    "close_wait_s": 120,
    "concurrent_runs": 2
  }
}
